/-! ### BTY's iteration lemma from the analytic chain, and the end results -/

theorem H_le_exp55 : (3 * 10 ^ 12 : ℝ) ≤ Real.exp 55.01 := by
  have h := Real.sum_le_exp_of_nonneg (x := (55.01 : ℝ)) (by norm_num) 20
  norm_num [Finset.sum_range_succ, Nat.factorial] at h
  linarith

theorem exp55_le_exp76 : Real.exp 55.01 ≤ Real.exp 76.47 := Real.exp_le_exp.mpr (by norm_num)

/-- **The analytic chain of BTY, as an explicit hypothesis.**  For a zero ρ₀ = (β₀, t) with
H ≤ t ≤ T₁ that violates the step A → A + ε' (i.e. A ≤ (1−β₀) log t < A + ε'), put
η = 1 − β₀, σ = 1 − A/log(16t + 10¹⁰) and μ = (1−σ)/η.  Then (44)–(48) of BTY together with
their Lemmas 6, 9, 10, 12, 13 and (our corrected) Lemma 14 give Φ(η, μ) ≤ Kq·η·log t.
(These analytic steps are what `../bty_4.896/check_part*.py` checks numerically.) -/
def AnalyticChain (Z : Set (ℝ × ℝ)) (c T1 : ℝ) : Prop :=
  ∀ (A ε' : ℝ) (ρ : ℝ × ℝ), c ≤ A → 0 < ε' → ε' ≤ 1 / 10 ^ 100 → A + ε' ≤ A0 →
    FreeFrom Z (cl A) (3 * 10 ^ 12) → ρ ∈ Z → 3 * 10 ^ 12 ≤ ρ.2 → ρ.2 ≤ T1 →
    A ≤ (1 - ρ.1) * Real.log ρ.2 → (1 - ρ.1) * Real.log ρ.2 < A + ε' →
    Φ (1 - ρ.1) ((A / Real.log (16 * ρ.2 + 10 ^ 10)) / (1 - ρ.1)) ≤
      Kq * ((1 - ρ.1) * Real.log ρ.2)

theorem iteration_of_chain {Z : Set (ℝ × ℝ)} {c Ltop : ℝ} (hc : 1 / 6 < c)
    (hfinal : ∀ {L η μ A ε' : ℝ}, 28.72 ≤ L → L ≤ Ltop → 1 / 6 < A → A ≤ A0 → 0 < ε' →
      ε' ≤ 1 / 10 ^ 9 → A ≤ η * L → η * L < A + ε' → L / (L + 2.78) - 1 / 10 ^ 9 ≤ μ →
      μ ≤ 1 → Φ η μ ≤ Kq * (η * L) → False)
    (chain : AnalyticChain Z c (Real.exp Ltop)) :
    ∀ A ε', c ≤ A → 0 < ε' → ε' ≤ 1 / 10 ^ 100 → A + ε' ≤ A0 →
      FreeFrom Z (cl A) (3 * 10 ^ 12) → FreeOn Z (cl (A + ε')) (3 * 10 ^ 12) (Real.exp Ltop) := by
  intro A ε' hcA hε' hεle hAA0 hfree ρ hρ hγ hT
  have hγ0 : (0 : ℝ) < ρ.2 := lt_of_lt_of_le (by norm_num) hγ
  have hL : (28.72 : ℝ) ≤ Real.log ρ.2 := logH_ge.trans (Real.log_le_log (by norm_num) hγ)
  have hLpos : 0 < Real.log ρ.2 := by linarith
  have hLtop : Real.log ρ.2 ≤ Ltop := by
    rw [← Real.log_exp Ltop]; exact Real.log_le_log hγ0 hT
  have hA : 1 / 6 < A := lt_of_lt_of_le hc hcA
  have hβA : A ≤ (1 - ρ.1) * Real.log ρ.2 := by
    have h := hfree ρ hρ hγ
    unfold cl at h
    have : A / Real.log ρ.2 ≤ 1 - ρ.1 := by linarith
    rw [div_le_iff₀ hLpos] at this; linarith
  unfold cl
  by_contra hneg
  push Not at hneg
  have hlt : (1 - ρ.1) * Real.log ρ.2 < A + ε' := by
    have : 1 - ρ.1 < (A + ε') / Real.log ρ.2 := by linarith
    rw [lt_div_iff₀ hLpos] at this; linarith
  have hch := chain A ε' ρ hcA hε' hεle hAA0 hfree hρ hγ hT hβA hlt
  have hη0 : 0 < 1 - ρ.1 := by
    by_contra h; push Not at h; nlinarith
  have hℓL : Real.log ρ.2 ≤ Real.log (16 * ρ.2 + 10 ^ 10) :=
    Real.log_le_log hγ0 (by linarith)
  have hℓpos : 0 < Real.log (16 * ρ.2 + 10 ^ 10) := by linarith
  have hℓup : Real.log (16 * ρ.2 + 10 ^ 10) ≤ Real.log ρ.2 + 2.78 := by
    have h1 : 16 * ρ.2 + 10 ^ 10 ≤ ρ.2 * (16 + 10 ^ 10 / (3 * 10 ^ 12)) := by
      have : (10 : ℝ) ^ 10 ≤ ρ.2 * (10 ^ 10 / (3 * 10 ^ 12)) := by
        rw [mul_div_assoc', le_div_iff₀ (by norm_num)]; nlinarith
      nlinarith
    have h2 := Real.log_le_log (by positivity) h1
    rw [Real.log_mul hγ0.ne' (by norm_num)] at h2
    have := logK_le
    linarith
  -- abbreviations (generalize, so that later tactics see plain variables)
  generalize hLdef : Real.log ρ.2 = L at *
  generalize hℓdef : Real.log (16 * ρ.2 + 10 ^ 10) = ℓ at *
  generalize hηdef : 1 - ρ.1 = η at *
  have hμmul : A / ℓ / η * (ℓ * η) = A := by field_simp
  have hμ2 : A / ℓ / η ≤ 1 := by
    rw [div_div, div_le_one (mul_pos hℓpos hη0)]; nlinarith
  have hμ1 : L / (L + 2.78) - 1 / 10 ^ 9 ≤ A / ℓ / η := by
    by_contra h; push Not at h
    have hq0 : 0 ≤ L / (L + 2.78) - 1 / 10 ^ 9 := by
      rw [sub_nonneg, le_div_iff₀ (by linarith)]; nlinarith
    have hlη : 0 < ℓ * η := mul_pos hℓpos hη0
    have e1 : A < (L / (L + 2.78) - 1 / 10 ^ 9) * (ℓ * η) := by
      calc A = A / ℓ / η * (ℓ * η) := hμmul.symm
        _ < (L / (L + 2.78) - 1 / 10 ^ 9) * (ℓ * η) := mul_lt_mul_of_pos_right h hlη
    have e2 : (L / (L + 2.78) - 1 / 10 ^ 9) * (ℓ * η) ≤
        (L / (L + 2.78) - 1 / 10 ^ 9) * ((L + 2.78) * η) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hℓup hη0.le) hq0
    have e3 : (L / (L + 2.78) - 1 / 10 ^ 9) * ((L + 2.78) * η) =
        η * L - (L + 2.78) * η / 10 ^ 9 := by
      have : L + 2.78 ≠ 0 := by linarith
      field_simp
    have e4 : ε' ≤ (L + 2.78) * η / 10 ^ 9 := by
      have h6 : (1 : ℝ) / 6 ≤ (L + 2.78) * η := by nlinarith
      have h9 : (1 : ℝ) / 10 ^ 100 ≤ 1 / 6 / 10 ^ 9 := by norm_num
      have : 1 / 6 / 10 ^ 9 ≤ (L + 2.78) * η / 10 ^ 9 :=
        div_le_div_of_nonneg_right h6 (by norm_num)
      linarith
    nlinarith
  have hA0 : A ≤ A0 := by linarith
  have hε9 : ε' ≤ 1 / 10 ^ 9 := by
    have : (1 : ℝ) / 10 ^ 100 ≤ 1 / 10 ^ 9 := by norm_num
    linarith
  exact hfinal hL hLtop hA hA0 hε' hε9 hβA hlt hμ1 hμ2 hch

/-- **Classical region 1/(4.896 log t) for all t ≥ 3**, from: the BTY analytic chain on
[H, e^55.01]; Yang's thesis Littlewood region with 19.62; RH up to H = 3·10¹²; and any
classical starting region c/log t with c > 1/6 (e.g. Kadiri 2005, c = 1/5.69693).
This is the form used by the k = 67 proof (which needs a Littlewood region anyway). -/
theorem classical_region_4896_from_thesis {Z : Set (ℝ × ℝ)} {c : ℝ} (hc : 1 / 6 < c)
    (hcA : c ≤ A0) (start : FreeFrom Z (cl c) (3 * 10 ^ 12))
    (LW : FreeFrom Z (lw 19.62) (3 * 10 ^ 12))
    (RH : ∀ ρ ∈ Z, 3 ≤ ρ.2 → ρ.2 < 3 * 10 ^ 12 → ρ.1 = 1 / 2)
    (chain : AnalyticChain Z c (Real.exp 55.01)) : FreeFrom Z (cl A0) 3 := by
  have iter := iteration_of_chain (Ltop := 55.01) hc
    (fun h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 =>
      final_contradiction_55 h1 (by norm_num at h2 ⊢; linarith) h3 h4 h5 h6 h7 h8 h9 h10 h11) chain
  have reg := region_of_iteration (Z := Z) (H := 3 * 10 ^ 12) (T1 := Real.exp 55.01) (c := c)
    (A0 := A0) (ε := 1 / 10 ^ 100) (Z2 := 19.62) (by norm_num) H_le_exp55 hcA (by norm_num)
    (by norm_num) start LW (by unfold A0; exact cross_1962) iter
  exact region_from_three reg RH (by unfold A0; norm_num) (by unfold A0; exact log3_ge)

/-- **BTY Theorem 1 (as published, 21.233 above e^76.463)**, modulo the analytic chain on
[H, e^76.47], with our corrected constants. -/
theorem classical_region_4896_BTY {Z : Set (ℝ × ℝ)} {c : ℝ} (hc : 1 / 6 < c)
    (hcA : c ≤ A0) (start : FreeFrom Z (cl c) (3 * 10 ^ 12))
    (LW : FreeFrom Z (lw 21.233) (3 * 10 ^ 12))
    (RH : ∀ ρ ∈ Z, 3 ≤ ρ.2 → ρ.2 < 3 * 10 ^ 12 → ρ.1 = 1 / 2)
    (chain : AnalyticChain Z c (Real.exp 76.47)) : FreeFrom Z (cl A0) 3 := by
  have iter := iteration_of_chain (Ltop := 76.47) hc
    (fun h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 =>
      final_contradiction_76 h1 (by norm_num at h2 ⊢; linarith) h3 h4 h5 h6 h7 h8 h9 h10 h11) chain
  have reg := region_of_iteration (Z := Z) (H := 3 * 10 ^ 12) (T1 := Real.exp 76.47) (c := c)
    (A0 := A0) (ε := 1 / 10 ^ 100) (Z2 := 21.233) (by norm_num) (H_le_exp55.trans exp55_le_exp76)
    hcA (by norm_num) (by norm_num) start LW (by unfold A0; exact cross_21233) iter
  exact region_from_three reg RH (by unfold A0; norm_num) (by unfold A0; exact log3_ge)

/-- Kadiri's constant 1/5.69693 is a valid starting point. -/
theorem kadiri_start_ok : (1 : ℝ) / 6 < 1 / 5.69693 ∧ (1 : ℝ) / 5.69693 ≤ A0 := by
  unfold A0; constructor <;> norm_num

