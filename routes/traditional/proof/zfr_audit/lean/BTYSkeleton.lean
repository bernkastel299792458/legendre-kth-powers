import Mathlib

namespace ZFRAudit.BTY

open Real

/-! ### Abstract zero sets and regions -/

/-- `FreeFrom Z w lo`: every zero (β, γ) ∈ Z with γ ≥ lo has β ≤ 1 − w(γ). -/
def FreeFrom (Z : Set (ℝ × ℝ)) (w : ℝ → ℝ) (lo : ℝ) : Prop :=
  ∀ ρ ∈ Z, lo ≤ ρ.2 → ρ.1 ≤ 1 - w ρ.2

/-- `FreeOn Z w lo hi`: the same for lo ≤ γ ≤ hi. -/
def FreeOn (Z : Set (ℝ × ℝ)) (w : ℝ → ℝ) (lo hi : ℝ) : Prop :=
  ∀ ρ ∈ Z, lo ≤ ρ.2 → ρ.2 ≤ hi → ρ.1 ≤ 1 - w ρ.2

/-- classical width A / log γ -/
noncomputable def cl (A : ℝ) (γ : ℝ) : ℝ := A / Real.log γ

/-- Littlewood width log log γ / (Z₂ log γ) -/
noncomputable def lw (Z2 : ℝ) (γ : ℝ) : ℝ := Real.log (Real.log γ) / (Z2 * Real.log γ)

/-- Beyond the crossover the Littlewood region contains the classical one. -/
theorem cl_le_lw {A Z2 T1 γ : ℝ} (hZ2 : 0 < Z2) (hT1 : 1 < T1) (hγ : T1 ≤ γ)
    (hcross : Z2 * A ≤ Real.log (Real.log T1)) : cl A γ ≤ lw Z2 γ := by
  have hlT : 0 < Real.log T1 := Real.log_pos hT1
  have hlg : 0 < Real.log γ := Real.log_pos (lt_of_lt_of_le hT1 hγ)
  have hmono : Real.log (Real.log T1) ≤ Real.log (Real.log γ) :=
    Real.log_le_log hlT (Real.log_le_log (by linarith) hγ)
  unfold cl lw
  rw [div_le_div_iff₀ hlg (mul_pos hZ2 hlg)]
  nlinarith

theorem region_step {Z : Set (ℝ × ℝ)} {H T1 A0 Z2 A ε' : ℝ} (hH : 1 < H) (hHT : H ≤ T1)
    (hZ2 : 0 < Z2) (LW : FreeFrom Z (lw Z2) H) (cross : Z2 * A0 ≤ Real.log (Real.log T1))
    (hA : A + ε' ≤ A0) (hon : FreeOn Z (cl (A + ε')) H T1) : FreeFrom Z (cl (A + ε')) H := by
  intro ρ hρ hγ
  by_cases hT : ρ.2 ≤ T1
  · exact hon ρ hρ hγ hT
  · push Not at hT
    have h1 := LW ρ hρ hγ
    have hc : Z2 * (A + ε') ≤ Real.log (Real.log T1) := by nlinarith
    have := cl_le_lw hZ2 (lt_of_lt_of_le hH hHT) hT.le hc
    linarith

/-- **Iteration ⇒ region.** -/
theorem region_of_iteration {Z : Set (ℝ × ℝ)} {H T1 c A0 ε Z2 : ℝ} (hH : 1 < H) (hHT : H ≤ T1)
    (hc : c ≤ A0) (hε : 0 < ε) (hZ2 : 0 < Z2)
    (start : FreeFrom Z (cl c) H) (LW : FreeFrom Z (lw Z2) H)
    (cross : Z2 * A0 ≤ Real.log (Real.log T1))
    (iter : ∀ A ε', c ≤ A → 0 < ε' → ε' ≤ ε → A + ε' ≤ A0 →
      FreeFrom Z (cl A) H → FreeOn Z (cl (A + ε')) H T1) :
    FreeFrom Z (cl A0) H := by
  have step : ∀ A ε', c ≤ A → 0 < ε' → ε' ≤ ε → A + ε' ≤ A0 →
      FreeFrom Z (cl A) H → FreeFrom Z (cl (A + ε')) H := fun A ε' h1 h2 h3 h4 h5 =>
    region_step hH hHT hZ2 LW cross h4 (iter A ε' h1 h2 h3 h4 h5)
  have ind : ∀ n : ℕ, c + n * ε ≤ A0 → FreeFrom Z (cl (c + n * ε)) H := by
    intro n
    induction n with
    | zero => intro _; simpa using start
    | succ k ih =>
      intro hk
      have hk' : c + k * ε ≤ A0 := by push_cast at hk; nlinarith
      have := step (c + k * ε) ε (by nlinarith [Nat.cast_nonneg (α := ℝ) k]) hε le_rfl
        (by push_cast at hk; linarith) (ih hk')
      have e : c + ((k + 1 : ℕ) : ℝ) * ε = c + k * ε + ε := by push_cast; ring
      rw [e]; exact this
  set N := ⌊(A0 - c) / ε⌋₊ with hN
  have hq : 0 ≤ (A0 - c) / ε := div_nonneg (by linarith) hε.le
  have hN1 : (N : ℝ) * ε ≤ A0 - c := by
    have := Nat.floor_le hq
    rwa [le_div_iff₀ hε] at this
  have hN2 : A0 - c < ((N : ℝ) + 1) * ε := by
    have := Nat.lt_floor_add_one ((A0 - c) / ε)
    rwa [div_lt_iff₀ hε] at this
  have base := ind N (by linarith)
  by_cases heq : c + N * ε = A0
  · rw [← heq]; exact base
  · have hpos : 0 < A0 - (c + N * ε) := by
      rcases lt_or_eq_of_le (show c + N * ε ≤ A0 by linarith) with h | h
      · linarith
      · exact absurd h heq
    have := step (c + N * ε) (A0 - (c + N * ε)) (by nlinarith [Nat.cast_nonneg (α := ℝ) N])
      hpos (by nlinarith) (by linarith) base
    have e : c + N * ε + (A0 - (c + N * ε)) = A0 := by ring
    rwa [e] at this

/-- Extension below H by the RH verification (zeros with 3 ≤ γ < H have β = 1/2). -/
theorem region_from_three {Z : Set (ℝ × ℝ)} {H A0 : ℝ} (hreg : FreeFrom Z (cl A0) H)
    (RH : ∀ ρ ∈ Z, 3 ≤ ρ.2 → ρ.2 < H → ρ.1 = 1 / 2) (hA0 : 0 ≤ A0)
    (h3 : 2 * A0 ≤ Real.log 3) : FreeFrom Z (cl A0) 3 := by
  intro ρ hρ hγ
  by_cases hH : H ≤ ρ.2
  · exact hreg ρ hρ hH
  · push Not at hH
    rw [RH ρ hρ hγ hH]
    have hl3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
    have hl : Real.log 3 ≤ Real.log ρ.2 := Real.log_le_log (by norm_num) hγ
    have hlp : 0 < Real.log ρ.2 := lt_of_lt_of_le hl3 hl
    unfold cl
    have : A0 / Real.log ρ.2 ≤ 1 / 2 := by
      rw [div_le_iff₀ hlp]; nlinarith
    linarith

