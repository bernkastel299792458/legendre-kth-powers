  have h2 := Real.exp_bound_div_one_sub_of_interval (x := (3 / 408 : ℝ)) (by norm_num) (by norm_num)
  have hp : 0 < Real.exp (3 / 408 : ℝ) := Real.exp_pos _
  calc Real.exp 4 * Real.exp (3 / 408) ≤ 2.7182818286 ^ 4 * (1 / (1 - 3 / 408)) := by
        apply mul_le_mul h1.le h2 hp.le (by norm_num)
    _ ≤ 55.01 := by norm_num

