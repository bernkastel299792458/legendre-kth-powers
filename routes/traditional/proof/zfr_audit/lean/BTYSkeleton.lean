  have h : Real.exp 4 = Real.exp 1 ^ 4 := by
    rw [← Real.exp_nat_mul]; norm_num
  rw [h]
  exact pow_lt_pow_left₀ Real.exp_one_lt_d9 (Real.exp_pos 1).le (by norm_num)

/-- crossover for the thesis constant: 19.62 · (1/4.896) ≤ log 55.01 = log log e^55.01. -/
theorem cross_1962 : (19.62 : ℝ) * (125 / 612) ≤ Real.log (Real.log (Real.exp 55.01)) := by
  rw [Real.log_exp, Real.le_log_iff_exp_le (by norm_num)]
  have hx : (19.62 : ℝ) * (125 / 612) = 4 + 3 / 408 := by norm_num
  rw [hx, Real.exp_add]
