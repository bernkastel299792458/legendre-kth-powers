  push Not at c0
  by_cases c1 : s ≤ ((3 : ℝ) / 4)
  · exact G_pos_cell1 s (by linarith) c1
  push Not at c1
  by_cases c2 : s ≤ ((7 : ℝ) / 8)
  · exact G_pos_cell2 s (by linarith) c2
  push Not at c2
  by_cases c3 : s ≤ ((15 : ℝ) / 16)
  · exact G_pos_cell3 s (by linarith) c3
  push Not at c3
  by_cases c4 : s ≤ ((31 : ℝ) / 32)
  · exact G_pos_cell4 s (by linarith) c4
  push Not at c4
  exact G_pos_cell5 s (by linarith) h1

/-- Lemma 5, polynomial part: N(Y) > 0 for all Y ≥ 0. -/
theorem N_pos (Y : ℝ) (hY : 0 ≤ Y) : 0 < N Y := by
  have h1 : 0 < 1 + Y := by linarith
  have hs0 : 0 ≤ Y / (1 + Y) := div_nonneg hY h1.le
  have hs1 : Y / (1 + Y) ≤ 1 := by rw [div_le_one h1]; linarith
  have hne : (1 + Y) ≠ 0 := h1.ne'
  have key : N Y = (1 + Y) ^ 6 * G (Y / (1 + Y)) := by
    unfold N G
    field_simp
    ring
  rw [key]
  have := G_pos _ hs0 hs1
  positivity

