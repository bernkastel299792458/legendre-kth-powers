theorem prime_1009 : Nat.Prime 1009 := by
  apply lucas_primality 1009 (11 : ZMod 1009)
  · reduce_mod_char
  · intro q hq hd
    have hfac : 1009 - 1 = (2 : ℕ)^4 * ((3 : ℕ)^2 * ((7 : ℕ)^1)) := by norm_num
    rw [hfac] at hd
    rcases hq.dvd_mul.mp hd with hd | hd
    · have heq : q = 2 := Nat.prime_eq_prime_of_dvd_pow hq prime_2 hd
      subst q
      change (11 : ZMod 1009)^504 ≠ 1
      reduce_mod_char
      decide
    · rcases hq.dvd_mul.mp hd with hd | hd
      · have heq : q = 3 := Nat.prime_eq_prime_of_dvd_pow hq prime_3 hd
        subst q
        change (11 : ZMod 1009)^336 ≠ 1
        reduce_mod_char
        decide
      · have heq : q = 7 := Nat.prime_eq_prime_of_dvd_pow hq prime_7 hd
        subst q
        change (11 : ZMod 1009)^144 ≠ 1
        reduce_mod_char
        decide

